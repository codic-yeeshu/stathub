# Install Rest client extension in vs code to hit api's directly from here
@serverUrl = http://localhost:8000
# @serverUrl = 

# ======================== Matches API ========================
GET {{serverUrl}}/matches/
Content-Type: application/json

###

POST {{serverUrl}}/matches/
Content-Type: application/json

{
    "sport": "football",
		"homeTeam": "Team A",
		"awayTeam": "Team B",
		"startTime": "2024-06-01T15:00:00Z",
		"endTime": "2024-06-01T17:00:00Z",
		"homeScore": 2,
		"awayScore": 1
}

###
# ======================== Commentaries API ========================
@matchId = 2
GET {{serverUrl}}/matches/{{matchId}}/commentary/
Content-Type: application/json

###

POST {{serverUrl}}/matches/{{matchId}}/commentary/
Content-Type: application/json

{
  "minute": 45,
	"sequence": 120,
	"period": "second",
	"eventType": "goal",
	"actor": "Alex Doe",
	"team": "Team A",
	"message": "Goal scored by Alex Doe for Team A",
	"metadata": {"assist": "john doe"} ,
	"tags": ["goal", "shot"]
}